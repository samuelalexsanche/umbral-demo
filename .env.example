# Copia este archivo a .env.local y llena los valores de tu proyecto de Supabase
# (Project Settings → API). La "anon key" es pública por diseño: la seguridad la ponen las políticas RLS.
# Sin estas dos variables, el sitio corre en modo local (datos en el navegador).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ruta base del sitio. GitHub Pages: /umbral-demo. Dominio propio o Cloudflare Pages: déjala vacía.
BASE_PATH=/umbral-demo
# Dominio público, sin barra final (para enlaces en invitaciones, sitemap y datos estructurados).
NEXT_PUBLIC_SITE_URL=https://samuelalexsanche.github.io
